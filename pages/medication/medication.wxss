/* pages/medication/medication.wxss */

.page-root {
  height: 100vh;
  background: linear-gradient(160deg, #EDEAFF 0%, #F5F4FF 45%, #EAF0FF 100%);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

/* ===== 通用卡片 ===== */
.card {
  background: rgba(255, 255, 255, 0.82);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(123, 104, 238, 0.12);
  border: 1.5rpx solid rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
}

/* ===== Tab 导航 ===== */
.tab-bar {
  display: flex;
  flex-direction: row;
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(20px);
  border-bottom: 1.5rpx solid rgba(123, 104, 238, 0.1);
  padding: 0 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0 24rpx;
  position: relative;
}

.tab-item::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  width: 60%;
  height: 4rpx;
  border-radius: 100rpx;
  background: transparent;
  transition: background 0.2s;
}

.tab-active::after {
  background: #7B68EE;
}

.tab-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #B0B0C8;
  transition: color 0.2s;
}

.tab-active .tab-text {
  color: #7B68EE;
}

/* ===== 滚动区 ===== */
.tab-scroll {
  flex: 1;
  height: 0;
}

.tab-content {
  padding: 32rpx 32rpx 0;
}

/* ===== 进度卡片 ===== */
.progress-card {
  padding: 40rpx 36rpx;
  margin-bottom: 24rpx;
  animation: fadeUp 0.35s cubic-bezier(0.22, 0.8, 0.4, 1) both;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.progress-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.progress-date {
  display: block;
  font-size: 22rpx;
  color: #9D9BBB;
  margin-bottom: 6rpx;
}

.progress-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #2D2B55;
}

.progress-ring {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #EEE9FF, #D8D0FF);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: row;
  box-shadow: 0 4rpx 16rpx rgba(123, 104, 238, 0.18);
}

.ring-done {
  background: linear-gradient(135deg, #52C47A, #6FD896);
  box-shadow: 0 4rpx 16rpx rgba(82, 196, 122, 0.28);
}

.progress-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #7B68EE;
  line-height: 1;
}

.ring-done .progress-num { color: #fff; }

.progress-total {
  font-size: 20rpx;
  color: #9D9BBB;
  align-self: flex-end;
  margin-bottom: 4rpx;
}

.ring-done .progress-total { color: rgba(255,255,255,0.8); }

.progress-bar-bg {
  height: 12rpx;
  border-radius: 100rpx;
  background: rgba(123, 104, 238, 0.1);
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-bar-fill {
  height: 100%;
  border-radius: 100rpx;
  background: linear-gradient(90deg, #7B68EE, #9B8BF5);
  transition: width 0.4s cubic-bezier(0.22, 0.8, 0.4, 1);
}

.fill-done {
  background: linear-gradient(90deg, #52C47A, #6FD896);
}

.progress-tip {
  font-size: 24rpx;
  color: #9D9BBB;
}

.tip-done { color: #52C47A; font-weight: 600; }

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 60rpx;
  gap: 16rpx;
}

.empty-icon  { font-size: 80rpx; }
.empty-text  { font-size: 30rpx; font-weight: 700; color: #2D2B55; }
.empty-sub   { font-size: 24rpx; color: #BBBBD4; text-align: center; }

/* ===== 今日用药卡片 ===== */
.med-card {
  padding: 32rpx 32rpx 28rpx;
  margin-bottom: 20rpx;
  animation: fadeUp 0.35s cubic-bezier(0.22, 0.8, 0.4, 1) both;
}

.med-card-header {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.med-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #EEE9FF, #DDD5FF);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2rpx 10rpx rgba(123, 104, 238, 0.15);
}

.med-icon   { font-size: 36rpx; }

.med-info { flex: 1; }

.med-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2D2B55;
  margin-bottom: 6rpx;
}

.med-dosage {
  display: block;
  font-size: 22rpx;
  color: #7B68EE;
  margin-bottom: 4rpx;
}

.med-note {
  display: block;
  font-size: 22rpx;
  color: #B0B0C8;
}

.slot-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  flex-wrap: wrap;
}

.slot-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  transition: transform 0.15s, box-shadow 0.15s;
}

.slot-btn:active { transform: scale(0.91); }

.slot-todo {
  background: rgba(123, 104, 238, 0.07);
  border: 2rpx solid rgba(123, 104, 238, 0.15);
}

.slot-done {
  background: linear-gradient(135deg, #52C47A, #6FD896);
  box-shadow: 0 4rpx 14rpx rgba(82, 196, 122, 0.35);
  border: 2rpx solid transparent;
}

.slot-check {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  height: 36rpx;
  line-height: 36rpx;
}

.slot-todo .slot-check { color: transparent; }

.slot-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #7B68EE;
}

.slot-done .slot-label { color: rgba(255,255,255,0.9); }

/* ===== 药单列表 ===== */
.med-list-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 28rpx;
  margin-bottom: 20rpx;
  animation: fadeUp 0.35s cubic-bezier(0.22, 0.8, 0.4, 1) both;
}

.med-list-left {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.med-list-info { flex: 1; min-width: 0; }

.time-tags {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
  flex-wrap: wrap;
  margin: 8rpx 0 4rpx;
}

.time-tag {
  background: rgba(123, 104, 238, 0.1);
  border-radius: 100rpx;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  color: #7B68EE;
  font-weight: 600;
}

.med-list-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.action-btn {
  padding: 10rpx 24rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

.edit-btn {
  background: rgba(123, 104, 238, 0.1);
  color: #7B68EE;
}

.del-btn {
  background: rgba(255, 107, 107, 0.1);
  color: #FF6B6B;
}

.add-btn-wrap {
  padding: 16rpx 0 0;
}

.add-btn {
  width: 100%;
  background: linear-gradient(135deg, #7B68EE, #9B8BF5);
  color: #fff;
  border-radius: 100rpx;
  padding: 30rpx 0;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(123, 104, 238, 0.38);
  line-height: 1;
}

/* ===== 日历 ===== */
.calendar-card {
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  animation: fadeUp 0.35s cubic-bezier(0.22, 0.8, 0.4, 1) both;
}

.calendar-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2D2B55;
  margin-bottom: 20rpx;
}

.calendar-legend {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.legend-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: #9D9BBB;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.cal-cell {
  aspect-ratio: 1;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.cal-today {
  box-shadow: 0 0 0 3rpx #7B68EE;
}

.cal-date-text {
  font-size: 16rpx;
  font-weight: 700;
  color: #fff;
}

/* 热力图颜色 */
.dot-l0 { background: rgba(123, 104, 238, 0.08); }
.dot-l1 { background: rgba(123, 104, 238, 0.2); }
.dot-l2 { background: rgba(123, 104, 238, 0.5); }
.dot-l3 { background: #7B68EE; }

.calendar-date-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 16rpx;
}

.cal-range-text { font-size: 20rpx; color: #BBBBD4; }

/* ===== 统计概览 ===== */
.stats-card {
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  animation: fadeUp 0.35s 0.05s cubic-bezier(0.22, 0.8, 0.4, 1) both;
}

.stats-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #2D2B55;
  margin-bottom: 28rpx;
}

.stats-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stats-num {
  font-size: 52rpx;
  font-weight: 800;
  color: #7B68EE;
  line-height: 1;
}

.stats-label {
  font-size: 22rpx;
  color: #9D9BBB;
}

.stats-divider {
  width: 1.5rpx;
  height: 70rpx;
  background: rgba(123, 104, 238, 0.12);
}

/* ===== 添加/编辑弹窗 ===== */
.overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.overlay-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(30, 24, 70, 0.48);
  animation: fadeIn 0.2s ease both;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.sheet {
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 20rpx 40rpx 0;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.28s cubic-bezier(0.22, 0.8, 0.4, 1) both;
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  overflow-y: auto;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}

.sheet-handle {
  width: 72rpx; height: 8rpx;
  background: #E0DCFF;
  border-radius: 100rpx;
  align-self: center;
  margin-bottom: 32rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #2D2B55;
  margin-bottom: 36rpx;
}

.field-wrap {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #9D9BBB;
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}

.field-input {
  width: 100%;
  height: 88rpx;
  background: rgba(123, 104, 238, 0.06);
  border-radius: 16rpx;
  border: 1.5rpx solid rgba(123, 104, 238, 0.14);
  padding: 0 24rpx;
  font-size: 28rpx;
  line-height: 88rpx;
  color: #2D2B55;
  box-sizing: border-box;
}

.field-placeholder { color: #C4BEF0; font-size: 28rpx; line-height: 88rpx; }

.time-selector {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.time-option {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #9D9BBB;
  background: rgba(123, 104, 238, 0.06);
  border: 2rpx solid rgba(123, 104, 238, 0.12);
  transition: all 0.15s;
}

.time-selected {
  background: linear-gradient(135deg, #7B68EE, #9B8BF5);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 4rpx 14rpx rgba(123, 104, 238, 0.3);
}

.save-btn {
  width: 100%;
  background: linear-gradient(135deg, #7B68EE, #9B8BF5);
  color: #fff;
  border-radius: 100rpx;
  padding: 30rpx 0;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(123, 104, 238, 0.38);
  margin-top: 12rpx;
  margin-bottom: 20rpx;
  line-height: 1;
  flex-shrink: 0;
}

/* ===== 通用主按钮（兜底） ===== */
.btn-primary {
  line-height: 1;
  border: none;
  transition: transform 0.15s, box-shadow 0.15s;
}

.btn-primary:active {
  transform: scale(0.97);
}
