/* pages/annual/annual.wxss */

.annual-root {
  min-height: 100vh;
  background: linear-gradient(160deg, #EDEAFF 0%, #F5F4FF 45%, #EAF0FF 100%);
}

/* 加载 / 错误 */
.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 60rpx;
  gap: 24rpx;
}
.state-icon { font-size: 72rpx; }
.state-text { font-size: 28rpx; color: #9D9BBB; text-align: center; line-height: 1.7; }
.retry-btn {
  margin-top: 12rpx;
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #7B68EE, #9B8BF5);
  color: #fff;
  border-radius: 100rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* 重新生成按钮 */
.regen-btn {
  margin-left: auto;
  padding: 12rpx 28rpx;
  background: rgba(123, 104, 238, 0.1);
  border-radius: 100rpx;
  border: 1.5rpx solid rgba(123, 104, 238, 0.25);
}
.regen-btn-text {
  font-size: 22rpx;
  color: #7B68EE;
  font-weight: 600;
}

/* 头部 */
.annual-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 48rpx 40rpx 24rpx;
}
.annual-header-icon { font-size: 56rpx; }
.annual-header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #2D2B55;
}
.annual-header-date {
  display: block;
  font-size: 22rpx;
  color: #9D9BBB;
  margin-top: 6rpx;
}

/* 主体 */
.annual-body {
  padding: 0 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 通用卡片 */
.a-card {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(123, 104, 238, 0.12);
  border: 1.5rpx solid rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(24px);
}
.a-card-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
}
.a-card-icon { font-size: 36rpx; }
.a-card-title { font-size: 30rpx; font-weight: 700; color: #2D2B55; }
.a-card-content { font-size: 26rpx; color: #4A4870; line-height: 1.8; display: block; }

/* 彩色卡片背景 */
.a-card-mood     { background: rgba(238, 233, 255, 0.7); }
.a-card-physical { background: rgba(232, 248, 238, 0.7); }
.a-card-psycho   { background: rgba(232, 240, 255, 0.7); }
.a-card-suggest  { background: rgba(255, 250, 232, 0.7); }

/* 健康评分 */
.score-card { text-align: center; }
.score-wrap {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
}
.score-num { font-size: 96rpx; font-weight: 800; color: #7B68EE; line-height: 1; }
.score-unit { font-size: 32rpx; color: #9D9BBB; }
.score-bar-bg {
  width: 100%;
  height: 16rpx;
  background: #EEE9FF;
  border-radius: 100rpx;
  overflow: hidden;
}
.score-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #7B68EE, #9B8BF5);
  border-radius: 100rpx;
  transition: width 0.6s ease;
}

/* 打卡统计 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.stat-cell { text-align: center; }
.stat-num  { display: block; font-size: 40rpx; font-weight: 800; color: #7B68EE; }
.stat-label{ display: block; font-size: 20rpx; color: #BBBBD4; margin-top: 4rpx; }

/* 最佳/最低谷月份 */
.month-highlight-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.month-tag {
  flex: 1;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.month-best  { background: rgba(82, 196, 122, 0.15); }
.month-worst { background: rgba(255, 107, 107, 0.12); }
.month-tag-label { font-size: 20rpx; color: #9D9BBB; }
.month-tag-val   { font-size: 30rpx; font-weight: 700; color: #2D2B55; }

/* 月度迷你条形图 */
.monthly-bars {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  height: 110rpx;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}
.bar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  gap: 6rpx;
}
.bar-fill {
  width: 28rpx;
  min-height: 4rpx;
  background: linear-gradient(180deg, #9B8BF5, #7B68EE);
  border-radius: 8rpx 8rpx 0 0;
}
.bar-label { font-size: 16rpx; color: #BBBBD4; }

/* 高频情绪标签 */
.emotion-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.emotion-tag {
  padding: 8rpx 24rpx;
  background: rgba(123, 104, 238, 0.12);
  border-radius: 100rpx;
  font-size: 22rpx;
  color: #7B68EE;
  font-weight: 600;
}

/* 高频主诉标签 */
.complaint-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}
.complaint-tag {
  padding: 8rpx 24rpx;
  background: rgba(82, 196, 122, 0.15);
  border-radius: 100rpx;
  font-size: 22rpx;
  color: #3DA85C;
  font-weight: 600;
}

/* 来年建议 */
.suggest-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(123, 104, 238, 0.08);
}
.suggest-item:last-child { border-bottom: none; }
.suggest-index {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7B68EE, #9B8BF5);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  line-height: 40rpx;
  text-align: center;
}
.suggest-text { font-size: 26rpx; color: #4A4870; line-height: 1.7; flex: 1; }
