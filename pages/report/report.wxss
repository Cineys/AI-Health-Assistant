/* pages/report/report.wxss */

/* 年度报告评分 */
.score-card-inline { text-align: center; }
.score-big {
  display: block;
  font-size: 88rpx;
  font-weight: 800;
  color: #7B68EE;
  line-height: 1.1;
  margin-top: 8rpx;
}
.score-unit-sm { font-size: 30rpx; color: #9D9BBB; font-weight: 400; }

.report-root {
  min-height: 100vh;
  background: linear-gradient(160deg, #EDEAFF 0%, #F5F4FF 50%, #EAF0FF 100%);
  padding: 0 0 120rpx;
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* ===== 报告头部 ===== */
.report-header {
  background: linear-gradient(135deg, #7B68EE 0%, #9B8BF5 100%);
  padding: 40rpx 36rpx 36rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.header-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.header-logo-icon {
  font-size: 48rpx;
}

.header-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.header-date {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* ===== 免责横幅 ===== */
.disclaimer-banner {
  background: rgba(255, 200, 80, 0.12);
  border-left: 6rpx solid #FFB830;
  padding: 20rpx 28rpx;
  margin: 24rpx 36rpx 0;
  border-radius: 0 16rpx 16rpx 0;
}

.disclaimer-text {
  font-size: 22rpx;
  color: #8A6A00;
  line-height: 1.7;
}

/* ===== Tab 切换 ===== */
.tab-bar {
  display: flex;
  flex-direction: row;
  margin: 24rpx 36rpx 0;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 100rpx;
  padding: 6rpx;
  gap: 6rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 100rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #9B8BF5;
  transition: all 0.2s;
}

.tab-active {
  background: linear-gradient(135deg, #7B68EE, #9B8BF5);
  color: #fff;
  box-shadow: 0 4rpx 14rpx rgba(123, 104, 238, 0.35);
}

/* ===== 患者科普 ===== */
.section-patient {
  background: linear-gradient(135deg, rgba(80,200,120,0.06), rgba(100,220,140,0.1));
  border: 1.5rpx solid rgba(80, 180, 100, 0.2);
}

/* ===== 心身分析 ===== */
.section-psycho {
  background: linear-gradient(135deg, rgba(255,184,48,0.06), rgba(255,210,100,0.1));
  border: 1.5rpx solid rgba(255, 184, 48, 0.25);
}

/* ===== 医生版 ===== */
.section-doctor {
  background: linear-gradient(135deg, rgba(64,128,255,0.06), rgba(100,160,255,0.1));
  border: 1.5rpx solid rgba(64, 128, 255, 0.2);
}

/* ===== 报告正文 ===== */
.report-body {
  padding: 24rpx 36rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ===== 通用区块卡片 ===== */
.section-card {
  background: rgba(255, 255, 255, 0.86);
  border-radius: 28rpx;
  padding: 32rpx 30rpx 28rpx;
  box-shadow: 0 6rpx 28rpx rgba(123, 104, 238, 0.10);
  border: 1.5rpx solid rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  animation: fadeSlideUp 0.35s cubic-bezier(0.22, 0.8, 0.4, 1) both;
}

.section-header-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.section-icon {
  font-size: 32rpx;
}

.section-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #2D2B55;
  flex: 1;
}

.section-content {
  font-size: 27rpx;
  color: #4A4870;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* ===== 主诉加粗 ===== */
.chief {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D2B55;
}

/* ===== 现病史 / 基础排查子行 ===== */
.hpi-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-bottom: 14rpx;
  align-items: flex-start;
}

.hpi-row:last-child {
  margin-bottom: 0;
}

.hpi-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #9B8BF5;
  background: rgba(123, 104, 238, 0.08);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  flex-shrink: 0;
  line-height: 1.8;
}

.hpi-value {
  font-size: 26rpx;
  color: #4A4870;
  line-height: 1.8;
  flex: 1;
}

/* ===== AI 评估区块（高亮） ===== */
.section-highlight {
  background: linear-gradient(135deg, rgba(123,104,238,0.06), rgba(155,139,245,0.1));
  border: 1.5rpx solid rgba(123, 104, 238, 0.2);
}

.highlight-label {
  color: #7B68EE;
}

.highlight-content {
  color: #3A3575;
}

.badge-ai {
  font-size: 18rpx;
  color: #7B68EE;
  background: rgba(123, 104, 238, 0.1);
  border: 1rpx solid rgba(123, 104, 238, 0.25);
  border-radius: 100rpx;
  padding: 4rpx 16rpx;
  font-weight: 600;
}

/* ===== 就医建议区块 ===== */
.section-recommend {
  background: linear-gradient(135deg, rgba(80,200,120,0.06), rgba(100,220,140,0.1));
  border: 1.5rpx solid rgba(80, 180, 100, 0.2);
}

/* ===== 完整免责声明 ===== */
.full-disclaimer {
  margin: 24rpx 28rpx 0;
  padding: 20rpx 24rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 16rpx;
}

.full-disclaimer-text {
  font-size: 20rpx;
  color: #AAAACC;
  line-height: 1.8;
}

/* ===== 操作按钮 ===== */
.action-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding: 32rpx 36rpx 0;
}

.action-btn {
  flex: 1;
  border-radius: 100rpx;
  padding: 26rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  line-height: 1;
}

.btn-save {
  background: linear-gradient(135deg, #7B68EE, #9B8BF5);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(123, 104, 238, 0.35);
}

.btn-share {
  background: rgba(255, 255, 255, 0.9);
  color: #7B68EE;
  border: 1.5rpx solid rgba(123, 104, 238, 0.3);
}
