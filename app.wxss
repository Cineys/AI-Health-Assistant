/* ========== 全局 CSS 变量 ========== */
page {
  --primary:        #7B68EE;
  --primary-light:  #A89CF5;
  --primary-pale:   #EEE9FF;
  --primary-dark:   #5A4ED4;
  --bg:             #F4F3FF;
  --bg-card:        rgba(255, 255, 255, 0.82);
  --text-main:      #2D2B55;
  --text-sub:       #8886AA;
  --text-hint:      #BBBBD4;

  /* 三档阴影 */
  --shadow-sm:  0 2rpx 12rpx  rgba(123, 104, 238, 0.07);
  --shadow-md:  0 8rpx 32rpx  rgba(123, 104, 238, 0.13);
  --shadow-lg:  0 16rpx 48rpx rgba(123, 104, 238, 0.20);

  --radius:    32rpx;
  --radius-sm: 18rpx;
  --radius-xs: 12rpx;

  background: linear-gradient(160deg, #EDEAFF 0%, #F5F4FF 45%, #EAF0FF 100%);
  min-height: 100vh;
  width: 100%;
  overflow-x: hidden;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: var(--text-main);
  box-sizing: border-box;
}

/* ========== 全局通用类 ========== */
.card {
  background: var(--bg-card);
  border-radius: var(--radius);
  box-shadow: var(--shadow-md);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
}

.btn-primary {
  background: linear-gradient(135deg, #7B68EE 0%, #9B8BF5 100%);
  color: #fff;
  border-radius: 100rpx;
  padding: 24rpx 56rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(123, 104, 238, 0.38);
  text-align: center;
  border: none;
  transition: transform 0.15s, box-shadow 0.15s;
}

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(123, 104, 238, 0.25);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  letter-spacing: 1rpx;
  margin-bottom: 20rpx;
}

.text-sub {
  color: var(--text-sub);
  font-size: 24rpx;
}

/* ========== 全局入场动画 ========== */
@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.94); }
  to   { opacity: 1; transform: scale(1); }
}

@keyframes slideInLeft {
  from { opacity: 0; transform: translateX(-32rpx); }
  to   { opacity: 1; transform: translateX(0); }
}

@keyframes slideInRight {
  from { opacity: 0; transform: translateX(32rpx); }
  to   { opacity: 1; transform: translateX(0); }
}

.anim-slide-up  { animation: fadeSlideUp 0.35s cubic-bezier(0.22, 0.8, 0.4, 1) both; }
.anim-scale-in  { animation: scaleIn    0.3s  cubic-bezier(0.22, 0.8, 0.4, 1) both; }
.anim-fade-in   { animation: fadeIn     0.3s  ease both; }

/* ========== 底部安全区通用占位 ========== */
/* 用于聊天列表末尾等需要贴近底部输入栏的场景 */
.msg-safe-bottom {
  height: 24rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
